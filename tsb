    local function getByName(name)
        if not name or name=="None" then return nil end
        return Players:FindFirstChild(name)
    end

    local function addESP(part,tag,size,trans,color)
        if not part or not part:IsA("BasePart") then return end
        if part:FindFirstChild(tag) then return end
        local b=Instance.new("BoxHandleAdornment")
        b.Name=tag; b.Size=size; b.Color3=color
        b.Transparency=trans; b.AlwaysOnTop=true; b.ZIndex=10
        b.Adornee=part; b.Parent=part
    end

    local function addLabel(part,tag,text,color)
        if not part or not part:IsA("BasePart") then return end
        if part:FindFirstChild(tag.."_L") then return end
        local bb=Instance.new("BillboardGui")
        bb.Name=tag.."_L"; bb.AlwaysOnTop=true
        bb.Size=UDim2.new(0,120,0,30); bb.StudsOffset=Vector3.new(0,3.5,0)
        bb.Adornee=part; bb.Parent=part
        local lbl=Instance.new("TextLabel")
        lbl.BackgroundTransparency=1; lbl.Size=UDim2.new(1,0,1,0)
        lbl.Text=text; lbl.TextColor3=color
        lbl.TextStrokeTransparency=0.3; lbl.Font=Enum.Font.GothamBold
        lbl.TextSize=14; lbl.Parent=bb
    end

    local function clearESP(tag)
        for _,p in ipairs(Players:GetPlayers()) do
            if p.Character then
                for _,d in ipairs(p.Character:GetDescendants()) do
                    if (d:IsA("BoxHandleAdornment") or d:IsA("BillboardGui"))
                        and (d.Name==tag or d.Name==tag.."_L") then d:Destroy() end
                end
            end
        end
    end

