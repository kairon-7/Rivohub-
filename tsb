local function shakeFrame()
    for _=1,4 do
        TweenService:Create(kf,TweenInfo.new(0.04),{Position=UDim2.new(0.5,-226,0.5,-160)}):Play()
        task.wait(0.04)
        TweenService:Create(kf,TweenInfo.new(0.04),{Position=UDim2.new(0.5,-214,0.5,-160)}):Play()
        task.wait(0.04)
    end
    TweenService:Create(kf,TweenInfo.new(0.04),{Position=UDim2.new(0.5,-220,0.5,-160)}):Play()
end

local function loadHub()
