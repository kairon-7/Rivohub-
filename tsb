        RunService.RenderStepped:Connect(function()
            if fovDraw then
                fovDraw.Visible=state.fovCircle
                fovDraw.Radius=120
                fovDraw.Position=UserInputService:GetMouseLocation()
            end
        end)
    end)

    local btoolConn
    local function updateBTools(v)
        if btoolConn then btoolConn:Disconnect(); btoolConn=nil end
        if v then
            btoolConn=UserInputService.InputBegan:Connect(function(input,gpe)
                if gpe or input.UserInputType~=Enum.UserInputType.MouseButton1 then return end
                if not state.btools then return end
                local cam=Workspace.CurrentCamera
                local ur=cam:ScreenPointToRay(input.Position.X,input.Position.Y)
                local res=Workspace:Raycast(ur.Origin,ur.Direction*500)
                if res and res.Instance then
                    local part=res.Instance
                    local c=lp.Character
                    if part:IsA("BasePart") and not part.Anchored and not (c and part:IsDescendantOf(c)) then
                        pcall(function() part.Parent=nil end)
                        notify("B-Tools","Removed: "..part.Name,"trash-bin-trash")
                    end
                end
            end)
        end
    end

    local autoDodgeConn
    local function updateAutoDodge(v)
        if autoDodgeConn then autoDodgeConn:Disconnect(); autoDodgeConn=nil end
        if v then
            local _,hum,root=getChar()
            if hum then
                autoDodgeConn=hum.HealthChanged:Connect(function(hp)
                    if hp<hum.MaxHealth*0.95 and root then
                        local dodge=Vector3.new(math.random(-1,1),0,math.random(-1,1))
                        if dodge.Magnitude>0 then
                            pcall(function() root.CFrame=root.CFrame+dodge.Unit*8 end)
                        end
                    end
                end)
            end
        end
    end

    UserInputService.InputBegan:Connect(function(input,gpe)
        if gpe then return end
        if input.KeyCode==Enum.KeyCode.Z and state.teleportBehind then
            local _,_,root=getChar(); if not root then return end
            local nearest,nearDist=nil,math.huge
            for _,p in ipairs(Players:GetPlayers()) do
                if p~=lp and p.Character then
                    local pr=p.Character:FindFirstChild("HumanoidRootPart")
                    if pr then
                        local d=(pr.Position-root.Position).Magnitude
                        if d<nearDist then nearDist=d; nearest=pr end
                    end
                end
            end
            if nearest then root.CFrame=nearest.CFrame*CFrame.new(0,0,3) end
        end
    end)

    local clickAccum=0
    local slowAccum=0

    RunService.Heartbeat:Connect(function(dt)
        local char,hum,root=getChar()
        if not char or not hum or not root then stopFly(); return end

        hum.WalkSpeed=state.speedHack and state.speed or 16
        hum.JumpPower=state.infiniteJump and 9999 or state.jumpPower
        Workspace.Gravity=state.gravity

        if state.godMode then
            hum.MaxHealth=math.huge; hum.Health=math.huge; hum.BreakJointsOnDeath=false
        end
        if state.noFall then
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown,false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Physics,false)
        end

        if state.fly then
            if not flyBV or flyBV.Parent~=root then
                stopFly()
                flyBV=Instance.new("BodyVelocity"); flyBV.MaxForce=Vector3.new(1e9,1e9,1e9); flyBV.Parent=root
                flyBG=Instance.new("BodyGyro"); flyBG.MaxTorque=Vector3.new(1e9,1e9,1e9); flyBG.P=9000; flyBG.Parent=root
            end
            local move=Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then move+=Vector3.new(0,0,-1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then move+=Vector3.new(0,0,1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then move+=Vector3.new(-1,0,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then move+=Vector3.new(1,0,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move+=Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then move+=Vector3.new(0,-1,0) end
            if move.Magnitude>0 then move=move.Unit end
            local cam=Workspace.CurrentCamera
            local look=Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z)
            local right=Vector3.new(cam.CFrame.RightVector.X,0,cam.CFrame.RightVector.Z)
            local world=Vector3.zero
            if look.Magnitude>0 then world+=look.Unit*(-move.Z) end
            if right.Magnitude>0 then world+=right.Unit*move.X end
            world+=Vector3.new(0,move.Y,0)
            flyBV.Velocity=world*state.flySpeed; flyBG.CFrame=cam.CFrame
        else stopFly() end

        if state.aimbot then
            local nearest,nearDist=nil,math.huge
            for _,entry in ipairs(enemyCache) do
                if entry.root and entry.root.Parent then
                    local d=(entry.root.Position-root.Position).Magnitude
                    if d<nearDist then nearDist=d; nearest=entry.root end
                end
            end
            if nearest then
                local cam=Workspace.CurrentCamera
                local sf=math.clamp(state.aimbotSmooth/100,0.01,1)
                cam.CFrame=cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position,nearest.Position+Vector3.new(0,1.5,0)),sf)
            end
        end

        if state.killAura then
            for _,entry in ipairs(enemyCache) do
                if entry.hum and entry.hum.Parent and entry.root and entry.root.Parent then
                    if (entry.root.Position-root.Position).Magnitude<=state.killAuraRange then
                        pcall(function() entry.hum.Health=0 end)
                    end
                end
            end
        end

        if state.autoCombo then
            local nearest,nearDist=nil,math.huge
            for _,entry in ipairs(enemyCache) do
                if entry.root and entry.root.Parent then
                    local d=(entry.root.Position-root.Position).Magnitude
                    if d<nearDist then nearDist=d; nearest=entry end
                end
            end
            if nearest and nearest.root then
                pcall(function()
                    local vim=game:GetService("VirtualInputManager")
                    vim:SendMouseButtonEvent(0,0,0,true,game,0)
                    vim:SendMouseButtonEvent(0,0,0,false,game,0)
                end)
            end
        end

        if state.flingMode and state.flingTarget then doFling(state.flingTarget) end

        if state.esp then
            for _,entry in ipairs(enemyCache) do
                if entry.root and entry.root.Parent then
                    local col=entry.plr.Team and entry.plr.Team.TeamColor.Color or Color3.fromRGB(255,80,80)
                    addESP(entry.root,"Rivo_ESP",Vector3.new(3,5,3),0.4,col)
                    addLabel(entry.root,"Rivo_ESP",entry.plr.Name,col)
                end
            end
        else clearESP("Rivo_ESP") end

        if state.chamsESP then
            for _,entry in ipairs(enemyCache) do
                if entry.char then
                    for _,part in ipairs(entry.char:GetChildren()) do
                        if part:IsA("BasePart") and not part:FindFirstChild("Rivo_ChamsBox") then
                            local box=Instance.new("BoxHandleAdornment")
                            box.Name="Rivo_ChamsBox"; box.Size=part.Size
                            box.Color3=Color3.fromRGB(255,60,60); box.Transparency=0.35
                            box.AlwaysOnTop=true; box.ZIndex=10; box.Adornee=part; box.Parent=part
                        end
                    end
                end
            end
        else
            for _,p in ipairs(Players:GetPlayers()) do
                if p.Character then
                    for _,d in ipairs(p.Character:GetDescendants()) do
                        if d:IsA("BoxHandleAdornment") and d.Name=="Rivo_ChamsBox" then d:Destroy() end
                    end
                end
            end
        end

        if state.btools~=(btoolConn~=nil) then updateBTools(state.btools) end
        if state.autoDodge~=(autoDodgeConn~=nil) then updateAutoDodge(state.autoDodge) end

        clickAccum+=dt
        if state.autoClick then
            local rate=math.max(state.autoClickRate,20)/1000
            if clickAccum>=rate then
                clickAccum=0
                pcall(function()
                    local vim=game:GetService("VirtualInputManager")
                    vim:SendMouseButtonEvent(0,0,0,true,game,0)
                    vim:SendMouseButtonEvent(0,0,0,false,game,0)
                end)
            end
        end

        slowAccum+=dt
        if slowAccum>=2 then
            slowAccum=0
            if state.chatSpam then
                pcall(function()
                    local ch=game:GetService("TextChatService").TextChannels:FindFirstChild("RBXGeneral")
                    local msgs={"RIVO HUB TSB","Rivo Hub is goated","rivo hub best hub"}
                    if ch then ch:SendAsync(msgs[math.random(1,#msgs)]) end
                end)
            end
        end
    end)

    RunService.Stepped:Connect(function()
        if not state.noclip then return end
        local c=lp.Character; if not c then return end
        for _,part in ipairs(c:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide=false end
        end
    end)

    RunService.RenderStepped:Connect(function()
        if not state.freecam then return end
        local cam=Workspace.CurrentCamera; local move=Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move+=Vector3.new(0,0,-1) end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move+=Vector3.new(0,0,1) end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move+=Vector3.new(-1,0,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move+=Vector3.new(1,0,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move+=Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then move+=Vector3.new(0,-1,0) end
        if move.Magnitude>0 then
            move=move.Unit*0.5
            cam.CFrame=cam.CFrame+cam.CFrame.RightVector*move.X+cam.CFrame.UpVector*move.Y+cam.CFrame.LookVector*(-move.Z)
        end
    end)

    UserInputService.JumpRequest:Connect(function()
        if not state.infiniteJump then return end
        local _,hum=getChar(); if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end)

    Players.PlayerAdded:Connect(function(p)
        task.delay(0.5,function() notify("Joined",p.Name.." joined. Refresh dropdowns.","user-plus") end)
    end)
    Players.PlayerRemoving:Connect(function(p)
        if state.selectedPlayer==p then state.selectedPlayer=nil end
        if state.flingTarget==p then state.flingTarget=nil end
    end)

    notify("RIVO HUB","TSB loaded. Press V to toggle.","sword")
    print("RIVO HUB | TSB | Press V to toggle")
end

unlockBtn.MouseButton1Click:Connect(function()
    local entered=keyBox.Text:gsub("%s","")
    if entered==VALID_KEY then
        statusLbl.TextColor3=Color3.fromRGB(80,220,80)
        statusLbl.Text="Key valid! Loading..."
        task.wait(0.8)
        loadHub()
    else
        statusLbl.TextColor3=Color3.fromRGB(255,60,60)
        statusLbl.Text="Invalid key. Join Discord to get your key."
        keyBox.Text=""
        shakeFrame()
    end
end)

keyBox.FocusLost:Connect(function(enter)
    if enter then unlockBtn.MouseButton1Click:Fire() end
end)
