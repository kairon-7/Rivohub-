local function StopConn(k)
    if S[k] then S[k]:Disconnect() S[k] = nil end
end

local function GetTarget()
    local sel = S.SelectTarget ~= "" and S.SelectTarget or nil
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            local h = p.Character:FindFirstChildWhichIsA("Humanoid")
            if r and h and h.Health > 0 then
                if sel and p.Name:lower():find(sel:lower()) then return p end
                local d = Root and (Root.Position - r.Position).Magnitude or math.huge
                if d < bestDist then bestDist = d best = p end
            end
        end
    end
    return best
end

local function LowestHPTarget()
    local best, bestHP = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local h = p.Character:FindFirstChildWhichIsA("Humanoid")
            if h and h.Health > 0 and h.Health < bestHP then
                bestHP = h.Health
                best = p
            end
        end
    end
    return best
end

local function FireRemote(name, ...)
    for _, v in ipairs(game:GetDescendants()) do
        if (v:IsA("RemoteEvent") or v:IsA("RemoteFunction")) and v.Name == name then
            if v:IsA("RemoteEvent") then pcall(v.FireServer, v, ...) end
            if v:IsA("RemoteFunction") then pcall(v.InvokeServer, v, ...) end
        end
    end
end

