local saved = LoadKey()
if saved == VALID_KEY then
    KeyBox.Text = saved
    StatusLabel.TextColor3 = Green
    StatusLabel.Text = "Saved key loaded. Click Unlock."
end

SubmitBtn.MouseButton1Click:Connect(function()
    local entered = KeyBox.Text
    if entered == VALID_KEY then
        SaveKey(entered)
        StatusLabel.TextColor3 = Green
        StatusLabel.Text = "Key accepted. Loading..."
        task.wait(0.7)
        LaunchMainUI()
    else
        StatusLabel.TextColor3 = Red
        StatusLabel.Text = "Invalid key. Join the Discord to get yours."
        task.spawn(Shake)
    end
end)

